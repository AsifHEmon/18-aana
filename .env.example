# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# JWT_SECRET: Signing key for Admin HttpOnly session JWTs.
JWT_SECRET="CHANGE_ME_TO_A_STRONG_RANDOM_SECRET"

# Cloudinary credentials for product image uploads (optional; falls back to local /uploads storage if unset).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
